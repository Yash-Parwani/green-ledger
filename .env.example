ANTHROPIC_API_KEY=

# --- Session signing ---
# Signs the httpOnly cookie that carries the organization identity every CSR
# budget/scheduling tool acts on. REQUIRED in production — the app refuses to
# boot without it — and must be at least 32 chars. In dev an ephemeral secret
# is generated per process, so sessions drop on restart.
#   openssl rand -base64 32
SESSION_SECRET=

# --- Swiggy Builders Club MCP (real Food/Instamart/Dineout) ---
# Docs: https://mcp.swiggy.com/builders/llms.txt
#
# REQUIRED for Food/Instamart/Dineout search and order tools to work at all —
# there is no mock fallback for real Swiggy data (lib/*/mock-mcp.ts return an
# honest "not connected" error instead). Set this to true and connect a
# Swiggy account via the console header, or those tools simply won't work.
# GreenLedger's own product layer (budget tracking, 80G/GST docs) works
# either way — it was never mocked Swiggy data to begin with.
SWIGGY_MCP_ENABLED=false

# https://mcp.swiggy.com by default; override to mcp-staging.swiggy.com once
# Swiggy grants staging access.
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com

# Must exactly match a redirect URI allowlisted with Swiggy — email
# builders@swiggy.in to register one before OAuth will complete. Defaults to
# {origin}/api/auth/swiggy/callback if unset (fine for localhost dev).
SWIGGY_REDIRECT_URI=

# No client_id/secret needed here — the app performs Dynamic Client
# Registration (RFC 7591) automatically on first "Connect Swiggy" click.
# Applying for staging/production access (org info, redirect URIs, a demo
# video) happens at https://mcp.swiggy.com/builders/docs/start/access — that
# application is a manual step on Swiggy's site, not something this app does.
